# ==============================================================================
# AI Powered Interview and Evaluation System — Environment Configuration
# AI Interview & Career Preparation Platform — Environment Configuration
# ==============================================================================

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Security & JWT
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here

# Database Infrastructure (matches docker-compose defaults)
MONGODB_URI=mongodb://localhost:27017/ai-interview
SPRING_DATASOURCE_URL=jdbc:mariadb://localhost:3307/aiinterview_ai
SPRING_DATASOURCE_USERNAME=aiuser
SPRING_DATASOURCE_PASSWORD=aipassword

# Redis Infrastructure
REDIS_HOST=localhost
REDIS_PORT=6379

# Email Service (SMTP for OTP Verification)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_google_app_password_here

# Frontend Configuration (optional override)
VITE_API_URL=http://localhost:8080